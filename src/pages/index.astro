---
import BaseLayout from '../layouts/BaseLayout.astro';
import NotifyMe from '../components/NotifyMe.astro';
import ContactSheet from '../components/ContactSheet.astro';
import PlatformIcon from '../components/PlatformIcon.astro';
import { siteConfig } from '../config/site';
import { version, beta, releaseNotesUrl, changelogUrl, downloads, downloadUrl, type Download } from '../config/release';

const { notify } = siteConfig;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'PhotoCull',
  applicationCategory: 'PhotographyApplication',
  operatingSystem: 'macOS, Windows',
  softwareVersion: version,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const formats = [
  'JPEG', 'HEIC', 'CR2', 'CR3', 'NEF', 'NRW', 'ARW', 'SRF', 'SR2',
  'DNG', 'RAF', 'ORF', 'RW2', 'PEF', 'RWL', '3FR',
];
---

<BaseLayout jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="stack hero-copy">
        <div class="eyebrow-row">
          <span class="eyebrow">Free desktop app for photographers</span>
          {beta && <span class="badge-beta">Beta</span>}
        </div>
        <h1>Cull a shoot in <span class="accent">minutes</span>, not hours</h1>
        <p class="lead">
          PhotoCull groups a shoot into scenes, scores every frame for focus,
          exposure, eyes-open, and overall aesthetic, then exports your picks as
          XMP sidecars that Lightroom and Capture One read directly. Runs
          entirely on your own computer — no account, no upload, no subscription.
        </p>
        <p class="new-in">
          <strong>New in 0.4:</strong> it can also find tripod star sequences,
          suggest which frames to leave out, and stack the rest into a 16-bit TIFF.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href="#download">Download PhotoCull</a>
          <a class="btn btn-outline btn-lg" href="#how">See how it works</a>
        </div>
        {beta && (
          <p class="muted fine">
            PhotoCull is in public beta: it works, and it will have rough edges.
            If something breaks, please{' '}
            <a href="https://github.com/ossger/PhotoCull/issues">tell us on GitHub</a>.
          </p>
        )}
      </div>
      <div class="hero-art">
        <ContactSheet />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section container" id="how">
    <div class="how-grid">
      <div class="card how-card">
        <span class="how-num">1</span>
        <h3>Group into scenes</h3>
        <p class="muted">Open a shoot folder and PhotoCull groups it into scenes automatically, based on when each photo was taken.</p>
      </div>
      <div class="card how-card">
        <span class="how-num">2</span>
        <h3>Score every frame</h3>
        <p class="muted">Every frame gets a score for focus, exposure, eyes-open, and overall aesthetic.</p>
      </div>
      <div class="card how-card">
        <span class="how-num">3</span>
        <h3>Export your picks</h3>
        <p class="muted">Step through with the arrow keys, rate as you go, then export standard XMP sidecars for Lightroom or Capture One.</p>
      </div>
    </div>
  </section>

  <!-- Download -->
  <section class="section section-soft" id="download">
    <div class="container">
      <h2 class="center">Download</h2>
      <p class="center muted">Version {version}{beta && ' (beta)'} ·{' '}
        <a href={releaseNotesUrl}>release notes</a></p>
      <div class="grid grid-3 download-grid">
        {downloads.map((d: Download) => (
          <div class={`card download-card${d.available ? ' is-available' : ''}`}>
            <div class="icon"><PlatformIcon platform={d.platform} size={34} /></div>
            <div class="platform">{d.platform}</div>
            <div class="label">{d.label}</div>
            {d.available ? (
              <a class="btn btn-primary" href={downloadUrl(d)}>Download</a>
            ) : notify.endpoint ? (
              <>
                <span class="btn btn-disabled" aria-disabled="true">{d.note}</span>
                <NotifyMe platform={`${d.platform} — ${d.label}`} />
              </>
            ) : (
              <span class="btn btn-disabled" aria-disabled="true">{d.note}</span>
            )}
            {d.size && <div class="meta">{d.size}</div>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Install -->
  <section class="section container" id="install">
    <h2>Installing</h2>

    <div class="grid grid-2">
      <div>
        <h3 class="os-title"><PlatformIcon platform="macOS" size={22} /> macOS</h3>
        <ol class="steps steps-num">
          <li>Open the downloaded <code>.dmg</code> file, then drag <strong>PhotoCull</strong> into your Applications folder.</li>
          <li>Double-click PhotoCull to launch it. It's signed with a Developer ID certificate and notarized by Apple, so it opens normally — no extra steps.</li>
        </ol>
      </div>
      <div>
        <h3 class="os-title"><PlatformIcon platform="Windows" size={22} /> Windows</h3>
        <ol class="steps steps-num">
          <li>Run the downloaded installer.</li>
          <li>If you see a blue "Windows protected your PC" screen, click <strong>More info</strong>, then <strong>Run anyway</strong>.</li>
          <li>If Windows Defender flags or removes the app, add an exclusion for the PhotoCull install folder, or restore it from quarantine in Windows Security.</li>
        </ol>
      </div>
    </div>

    <div class="box box-warn first-run">
      <p class="box-title"><strong>Both platforms:</strong> the first launch needs an internet connection — PhotoCull downloads its face-detection and RAW-decoding model files the first time it runs. After that, everything works fully offline.</p>
    </div>
  </section>

  <!-- Why the warnings -->
  <section class="section section-soft">
    <div class="container measure">
      <h2>Why does my computer warn me about this?</h2>
      <p>
        The macOS build is signed with a Developer ID certificate and
        notarized by Apple, so it opens with no warning at all. The Windows
        build isn't signed with a paid code-signing certificate — that costs
        money every year, and this is a small, independently-built tool — so
        Windows shows you a warning because it can't vouch for who made it.
        That warning is expected. It doesn't mean the app is unsafe; it means
        nobody paid to remove the warning.
      </p>
      <p>
        You don't have to take that on faith, though. Verify the file you
        downloaded matches exactly what was published by checking its SHA-256
        hash — a unique fingerprint of the exact bytes in the file:
      </p>
      {downloads.filter((d) => d.available && d.sha256).map((d) => (
        <p>
          <strong>{d.platform} ({d.label}):</strong>
          <span class="hash">{d.sha256}</span>
        </p>
      ))}
      <p class="muted">
        On macOS: <code>shasum -a 256 PhotoCull-{version}-macOS-arm64.dmg</code> (or <code>-x64.dmg</code> for Intel).
        On Windows: <code>certutil -hashfile PhotoCull-{version}-Windows-x64.exe SHA256</code>.
        If the hash you compute doesn't match the one above, don't install it
        — download it again from this page.
      </p>
    </div>
  </section>

  <!-- What it does with your photos -->
  <section class="section container">
    <div class="grid grid-2 privacy-grid">
      <div class="stack">
        <h2>What it does with your photos</h2>
        <ul class="checks">
          <li>Everything runs on your computer — scoring, faces, RAW decoding, all local and offline.</li>
          <li>No account, no cloud upload, no telemetry.</li>
          <li>Your picks and ratings are saved next to your photos, in a small database in a <code>.photocull</code> folder inside the shoot itself.</li>
          <li>Exports write standard <code>.xmp</code> sidecar files next to your originals — nothing is moved or renamed unless you use the optional import tool.</li>
        </ul>
      </div>
      <div class="box box-ok">
        <h3 class="box-title">Supported formats</h3>
        <div class="tag-row">
          {formats.map((f) => <span class="tag">{f}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- System requirements -->
  <section class="section section-soft">
    <div class="container">
      <h2>System requirements</h2>
      <div class="grid grid-2">
        <div class="card">
          <h3>macOS</h3>
          <p class="muted flush">macOS 13 (Ventura) or newer, on Apple Silicon (M1 and later) or Intel.</p>
        </div>
        <div class="card">
          <h3>Windows</h3>
          <p class="muted flush">Windows 10 (version 1809) or newer, 64-bit.</p>
        </div>
      </div>
      <p class="muted spaced">
        A few hundred MB of disk space for the install. No Python or Node.js
        needed — everything PhotoCull requires is bundled in.
      </p>
    </div>
  </section>

  <!-- Getting started -->
  <section class="section container" id="start">
    <h2>Getting started</h2>
    <p class="measure">
      Open a shoot folder, and PhotoCull groups it into scenes automatically
      based on when each photo was taken. Step through with the arrow keys,
      rate as you go, then export your picks.
    </p>
    <div class="hotkey-grid">
      <div><kbd>← / →</kbd><span>Previous / next photo</span></div>
      <div><kbd>P</kbd><span>Pick</span></div>
      <div><kbd>X</kbd><span>Reject</span></div>
      <div><kbd>U</kbd><span>Clear pick/reject</span></div>
      <div><kbd>0–5</kbd><span>Star rating</span></div>
      <div><kbd>G</kbd><span>Grid view</span></div>
      <div><kbd>C</kbd><span>Compare view</span></div>
      <div><kbd>R</kbd><span>Crop</span></div>
      <div><kbd>E</kbd><span>Eye-zoom loupe</span></div>
      <div><kbd>F</kbd><span>Face / eye overlay</span></div>
      <div><kbd>/</kbd><span>Filter panel</span></div>
      <div><kbd>?</kbd><span>All keyboard shortcuts</span></div>
    </div>
  </section>

  <!-- Support -->
  <section class="section section-soft" id="support">
    <div class="container">
      <h2>Support PhotoCull</h2>
      <p class="measure">
        PhotoCull is free and open source (MIT). If it saves you time on a
        shoot, a small donation keeps it moving. Bug reports and feature ideas
        help just as much.
      </p>
      <div class="cta-row support-row">
        <a class="btn btn-primary" href="https://buymeacoffee.com/ossger">Buy me a coffee</a>
        <a class="btn btn-outline" href="https://github.com/ossger/PhotoCull">Source on GitHub</a>
        <a class="btn btn-outline" href="https://github.com/ossger/PhotoCull/issues/new/choose">Report a bug or idea</a>
      </div>
    </div>
  </section>

  <Fragment slot="footer">
    <p>
      PhotoCull {version} · <a href={releaseNotesUrl}>Release notes</a> ·{' '}
      <a href={changelogUrl}>All versions</a>
    </p>
  </Fragment>
</BaseLayout>
